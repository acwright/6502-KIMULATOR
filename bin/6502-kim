#!/usr/bin/env node
// Dev entry point for the 6502-kim CLI.
//
// The installed shim runs the bundled build through Electron's own Node, so no
// separate runtime is needed and the CLI can never be a different version from
// the app. From a checkout, build with `npm run build:cli` and this runs the
// output.
'use strict'

const { existsSync } = require('node:fs')
const { join } = require('node:path')

const entry = join(__dirname, '..', 'out', 'cli', 'index.js')

if (!existsSync(entry)) {
  process.stderr.write('6502-kim: CLI is not built yet — run `npm run build:cli`\n')
  process.exit(1)
}

require(entry)
